CREATE TABLE producto (
    id INTEGER NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    precio REAL NOT NULL,
    stock INTEGER NOT NULL,
    pendiente INTEGER NOT NULL DEFAULT 0,
    intentos INTEGER NOT NULL DEFAULT 0,
    ultimoError TEXT,
    estado INTEGER NOT NULL DEFAULT 1,
    categoriaId INTEGER
);

listarTodos:
SELECT * FROM producto ORDER BY nombre ASC;

listarPendientes:
SELECT * FROM producto WHERE pendiente = 1;

insertar:
INSERT OR REPLACE INTO producto (
    id, nombre, precio, stock, pendiente, estado, categoriaId
)
VALUES (?, ?, ?, ?, ?, ?, ?);

borrarSincronizados:
DELETE FROM producto WHERE pendiente = 0;

siguienteIdLocal:
SELECT COALESCE(MIN(id), 0) FROM producto;

borrarPorId:
DELETE FROM producto WHERE id = ?;

actualizarCategoria:
UPDATE producto SET categoriaId = ? WHERE id = ?;

actualizarProducto:
UPDATE producto
SET nombre = ?,
    precio = ?,
    stock = ?,
    estado = ?,
    categoriaId = ?,
    pendiente = 1
WHERE id = ?;

pendientesPorEnviar:
SELECT * FROM producto
WHERE pendiente = 1 AND intentos < :maxIntentos
ORDER BY id;

contarPendientes:
SELECT COUNT(*) FROM producto
WHERE pendiente = 1 AND intentos < :maxIntentos;

contarFallidas:
SELECT COUNT(*) FROM producto
WHERE pendiente = 1 AND intentos >= :maxIntentos;

sumarIntento:
UPDATE producto
SET intentos = intentos + 1,
    ultimoError = ?
WHERE id = ?;

marcarFallida:
UPDATE producto
SET intentos = :maxIntentos,
    ultimoError = :motivo
WHERE id = :id;

reiniciarIntentos:
UPDATE producto
SET intentos = 0,
    ultimoError = NULL
WHERE id = ?;